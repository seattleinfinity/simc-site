{
  "name": "simc-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "typecheck": "react-router typegen && tsc --noEmit",
    "build": "npm run typecheck && react-router build && npm run seo:generate && npm run seo:check",
    "seo:generate": "node scripts/generate-seo-assets.mjs",
    "seo:check": "node scripts/check-seo.mjs",
    "preview": "sirv dist/client --single __spa-fallback.html --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@react-router/node": "7.18.2",
    "dompurify": "latest",
    "isbot": "^5",
    "katex": "^0.16.8",
    "markdown-it": "^13.0.1",
    "react": "latest",
    "react-dom": "latest",
    "react-router": "7.18.2",
    "vite": "latest"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "^26.1.0",
    "sirv-cli": "^3.0.1",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  }
}
