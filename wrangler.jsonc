{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "simc-site",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-26",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
